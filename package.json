{
  "name": "nutridebby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "admin:criar": "tsx --env-file-if-exists=.env.local scripts/admin-criar.ts",
    "e2e:seed": "tsx --env-file-if-exists=.env.local scripts/e2e-seed.ts",
    "seed:taco": "tsx scripts/seeds/gerar-taco.ts",
    "seed:medidas": "tsx scripts/seeds/gerar-medidas.ts",
    "icones": "tsx scripts/gerar-icones.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@react-pdf/renderer": "4.9.0",
    "@serwist/turbopack": "9.5.12",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.30.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "otpauth": "^9.5.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "packageManager": "pnpm@12.6.0"
}
