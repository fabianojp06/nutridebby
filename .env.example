# --- Plano 01 ---
NODE_ENV=development
APP_URL=http://localhost:3100
# role da aplicação (sem SUPERUSER/BYPASSRLS) — criado pelo `pnpm db:migrate`
DATABASE_URL=postgres://nutri_app:dev-app@localhost:54329/nutri
# role dono do schema — só `pnpm db:migrate` / scripts/migrate.ts lê esta variável.
# Em produção: só no serviço app (o entrypoint a remove antes de subir o Next); o worker NÃO recebe.
DATABASE_URL_MIGRATOR=postgres://nutri_owner:dev-owner@localhost:54329/nutri
# app e admin:criar (o worker não precisa)
AUTH_SECRET=
LOG_LEVEL=info
# CIDRs dos proxies confiáveis (rede do Traefik/Swarm). OBRIGATÓRIA em produção e no `next start` local; vazia em dev/test
TRUSTED_PROXIES=
# --- Plano 02 ---
# app e worker: chave AES-256 dos segredos da fila (gere com: openssl rand -base64 32)
ENCRYPTION_KEY=
# worker: remetente (domínio verificado no Resend em produção)
EMAIL_FROM=NutriDebby <nao-responda@localhost>
# worker: resend (padrão em produção) | mailpit (padrão fora de produção)
EMAIL_TRANSPORT=
# worker, produção: chave de envio do Resend
RESEND_API_KEY=
# worker, dev/CI: Mailpit do docker-compose (interface em http://localhost:8025)
MAILPIT_URL=http://localhost:8025
# app: segredo das URLs assinadas de arquivo (gere com: openssl rand -base64 48)
FILE_URL_SECRET=
# app e worker: pasta dos arquivos (produção: /data, volume montado nos dois serviços)
DATA_DIR=./data
# app: Turnstile (INT-06). Em dev, as chaves de teste da Cloudflare que sempre passam:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# --- Plano 05: WhatsApp pela Evolution API (D1). Sem estas, o WhatsApp fica desligado ---
# app e worker: endereço interno da Evolution (rede do Easypanel) e a AUTHENTICATION_API_KEY dela
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# só app: segredo do JWT do webhook (o mesmo que vai em `jwt_key`; gere com: openssl rand -base64 48)
EVOLUTION_WEBHOOK_SECRET=dev-webhook-secret-com-pelo-menos-32-caracteres
# só app: URL que a Evolution chama. Dev: opcional (padrão APP_URL + /api/webhooks/whatsapp).
# Produção: obrigatória e interna (ex.: http://nutridebby_app:3000/api/webhooks/whatsapp) — D4
EVOLUTION_WEBHOOK_URL=
# só app: 1 = aceitar uma EVOLUTION_WEBHOOK_URL pública em produção (opção explícita do runbook; o padrão é recusar)
EVOLUTION_WEBHOOK_URL_PUBLICA=
# dev/CI/E2E: mensagens vão para o Mailpit (<número>@whatsapp.sandbox); recusado em produção
WHATSAPP_SANDBOX=1
# --- Plano 05: push (INT-03, D19) ---
# worker: push (INT-03). Gere com: npx web-push generate-vapid-keys — sem as três, o push fica desligado
# (VAPID_SUBJECT: mailto:<e-mail de contato> ou https://<site>; as duas chaves precisam ser do mesmo par)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# --- Planos seguintes (spec §9.6) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_PASSPHRASE=
