# --- Plano 01 ---
NODE_ENV=development
APP_URL=http://localhost:3100
# role da aplicação (sem SUPERUSER/BYPASSRLS) — criado pelo `pnpm db:migrate`
DATABASE_URL=postgres://nutri_app:dev-app@localhost:54329/nutri
# role dono do schema — só `pnpm db:migrate` / scripts/migrate.ts lê esta variável.
# Em produção: só no serviço app (o entrypoint a remove antes de subir o Next); o worker NÃO recebe.
DATABASE_URL_MIGRATOR=postgres://nutri_owner:dev-owner@localhost:54329/nutri
# app e admin:criar (o worker não precisa)
AUTH_SECRET=
LOG_LEVEL=info
# CIDRs dos proxies confiáveis (rede do Traefik/Swarm). OBRIGATÓRIA em produção e no `next start` local; vazia em dev/test
TRUSTED_PROXIES=
# --- Plano 02 ---
# app e worker: chave AES-256 dos segredos da fila (gere com: openssl rand -base64 32)
ENCRYPTION_KEY=
# --- Planos seguintes (spec §9.6) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_PASSPHRASE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FILE_URL_SECRET=
DATA_DIR=
